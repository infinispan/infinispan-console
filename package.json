{
  "name": "infinispan-console",
  "version": "16.3",
  "description": "The console for Infinispan/Red Hat Data Grid",
  "main": "index.js",
  "repository": "https://github.com/infinispan/infinispan-console.git",
  "homepage": "http://localhost:11222/console/",
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "npm run clean",
    "dr:surge": "node dr-surge.js",
    "build": "webpack --config webpack.prod.js && npm run dr:surge",
    "start": "sirv dist --cors --single --host --port 8080",
    "start:dev": "webpack serve --hot --color --progress --config webpack.dev.js",
    "test": "jest",
    "eslint": "eslint ./src/",
    "lint": "npm run eslint",
    "format": "prettier --check --write ./src --config ./.prettierrc",
    "build:bundle-profile": "webpack --config webpack.prod.js --profile --json > stats.json",
    "bundle-profile:analyze": "npm run build:bundle-profile && webpack-bundle-analyzer ./stats.json",
    "clean": "rimraf dist",
    "cy:run": "cypress run --headless",
    "cy:run:chrome": "cypress run --headless --browser chrome",
    "cy:run:firefox": "cypress run --headless --browser firefox",
    "cy:e2e": "cypress open",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "prettier --config ./.prettierrc --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^18",
    "ajv": "^8.20.0",
    "baseline-browser-mapping": "^2.11.18",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cypress": "^15.21.0",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "globals": "^17.11.0",
    "html-webpack-plugin": "^5.6.8",
    "html-webpack-tags-plugin": "^3.0.2",
    "husky": "^9.1.7",
    "imagemin": "^9.0.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fixed-jsdom": "^0.0.11",
    "js2xmlparser": "^5.0.0",
    "lint-staged": "^17.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "raw-loader": "^4.0.2",
    "react-router-dom": "^7.18.2",
    "react-test-renderer": "^18",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.12",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.108.4",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "overrides": {
    "axios": "1.16.0",
    "dompurify": "3.4.11",
    "form-data": "^4.0.6",
    "file-type": "^21.3.4",
    "uuid": "^11.1.1",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@patternfly/patternfly": "^6.6.1",
    "@patternfly/react-charts": "^8.6.1",
    "@patternfly/react-code-editor": "^6.6.1",
    "@patternfly/react-component-groups": "^6.5.0",
    "@patternfly/react-core": "^6.6.0",
    "@patternfly/react-icons": "^6.6.0",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@patternfly/react-styles": "^6.6.0",
    "@patternfly/react-table": "^6.6.1",
    "@patternfly/react-tokens": "^6.6.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "json-bigint": "^1.0.0",
    "keycloak-js": "^26",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^17.0.12",
    "react-syntax-highlighter": "^16.1.1",
    "victory": "37.3.6"
  }
}
